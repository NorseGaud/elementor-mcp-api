#!/usr/bin/env bash
# Pre-commit: PHPCS on staged plugin PHP (same ruleset as CI).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [[ ! -f vendor/bin/phpcs ]]; then
  echo "pre-commit: vendor/bin/phpcs not found. Run: composer install" >&2
  exit 1
fi

files=()
while IFS= read -r -d '' f; do
  if [[ "$f" == "mcp-api-for-elementor.php" || "$f" == includes/* ]]; then
    files+=("$f")
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.php')

if [[ ${#files[@]} -eq 0 ]]; then
  exit 0
fi

echo "pre-commit: PHPCS (${#files[@]} file(s))..."
if ! vendor/bin/phpcs --standard=phpcs.xml.dist -- "${files[@]}"; then
  cat >&2 <<'EOF'

pre-commit: PHPCS found violations. Fix them before committing.

  composer lint:fix          # or: vendor/bin/phpcbf
  composer lint             # or: vendor/bin/phpcs
  git add <fixed files>     # re-stage, then commit again

EOF
  exit 1
fi
