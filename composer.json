{
    "name": "norsegaud/mcp-api-for-elementor",
    "description": "REST API + MCP tools for AI-driven Elementor page building",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-only",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit",
        "test:coverage": "phpdbg -qrr vendor/bin/phpunit --coverage-text"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.1.99"
        },
        "sort-packages": true
    }
}
